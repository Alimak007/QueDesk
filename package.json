{
  "name": "quedesk",
  "version": "1.0.0",
  "private": true,
  "description": "QueDesk — role-based business management portal (MERN)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "seed:demo": "npm run seed:demo -w server",
    "test": "npm run test -w server",
    "lint": "npm run lint -w client",
    "seed:companies": "npm run seed:companies -w server"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
