NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=quedesk
# Optional: comma-separated DNS servers if SRV lookups fail (e.g. 1.1.1.1,8.8.8.8)
DNS_SERVERS=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=myportal_token

# Used by `npm run seed` to create the first admin account
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-Str0ng
SEED_ADMIN_NAME=Portal Admin
